{
  "manifest_version": 3,
  "name": "VK Moosic Downloader (Expansion)",
  "version": "1.1.0",
  "description": "Скачивание треков VK по ссылке и прямо со страницы.",
  "permissions": ["storage", "downloads"],
  "host_permissions": [
    "https://api.vk.com/*",
    "https://*.userapi.com/*",
    "https://*.vk-cdn.net/*",
    "https://*.mycdn.me/*",
    "https://*.okcdn.ru/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VK Music Downloader"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://vk.com/*", "https://m.vk.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}